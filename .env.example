# Production secrets are supplied by Secrets Manager, not committed here.
# AWS Compose refuses to start without database passwords.
POSTGRES_PASSWORD=
LICENSE_DB_PASSWORD=

# Optional host port for the web app (AWS Compose defaults to 80).
APP_PORT=8080
LICENSE_POSTGRES_PORT=5433

# Lemon Squeezy store configuration. Keep secrets server-side.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
# Create distinct one-time variants for 1, 2, and 3 credits. Quantity is fixed to 1.
# Suggested introductory EUR prices: 9.90 / 17.90 / 23.90, final price set in checkout.
LEMON_SQUEEZY_VARIANT_TWO_ID=
LEMON_SQUEEZY_VARIANT_THREE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
PAYMENT_TEST_MODE=false
APP_PUBLIC_URL=

# Cognito values are supplied by infra/cognito-user-pool.yaml stack outputs.
COGNITO_ISSUER_URI=
COGNITO_APP_CLIENT_ID=
COGNITO_HOSTED_UI_AUTHORITY=
COGNITO_IDP_ORIGIN=https://cognito-idp.REGION.amazonaws.com
COGNITO_REDIRECT_URI=
COGNITO_LOGOUT_REDIRECT_URI=
LICENSE_REQUIRE_ACCOUNT_AUTH=true
SUPPORT_EMAIL=
# For an ALB, use its VPC subnet CIDR and restrict EC2 ingress to the ALB security group.
TRUSTED_PROXY_CIDR=127.0.0.1/32
LICENSE_TEST_MODE=false
LICENSE_TEST_CODE=
LICENSE_TEST_CREDITS=3

# Enable only in local or isolated hosted testing, never in production.
# LICENSE_TEST_MODE=true
# LICENSE_TEST_CODE=replace-with-a-long-random-test-code
# LICENSE_TEST_CREDITS=3

# Leave false on hosted deployments. Local anonymous checkout is limited to payment test mode.
LICENSE_ALLOW_ANONYMOUS_CHECKOUT=false
